# Landing (prerenderized static HTML; cache leve, revalidação em background)
# `/pt` and `/pt/*` rules removed — pt-BR is served at `/` with no prefix.
/
  Cache-Control: public, s-maxage=300, stale-while-revalidate=86400
/en
  Cache-Control: public, s-maxage=300, stale-while-revalidate=86400

# Legal (prerenderized static HTML; raramente muda)
/privacy
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=604800
/en/privacy
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=604800
/terms
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=604800
/en/terms
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=604800

# Auth — nunca cachear, nunca indexar
/signin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/signup
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/recover
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Vite assets com hash — imutáveis
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SEO
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain

# Version manifest (detecção de deploy novo)
/version.json
  Cache-Control: no-store

# Headers de segurança globais
#
# CSP em Report-Only: coleta violações sem bloquear. Após dias monitorando via
# DevTools (Console → CSP Violations), promover para `Content-Security-Policy`.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  X-DNS-Prefetch-Control: on
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.convex.cloud; font-src 'self' data:; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://*.convex.site; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
